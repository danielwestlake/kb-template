# Fellow API credentials
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit it.

# Required: your Fellow API key
# Get it from Fellow → Settings → Integrations → API
FELLOW_API_KEY=your_fellow_api_key_here

# Optional: override the Fellow API base URL (default shown below)
# FELLOW_API_URL=https://api.fellow.app/v2
